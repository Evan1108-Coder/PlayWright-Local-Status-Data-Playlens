# PlayLens Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See ENV.md for detailed documentation on each variable.

# --- AI Configuration (optional, server-side only) ---
# Set ONE OR MORE provider API keys to enable AI features.
# NOTE: Keys are NOT prefixed with VITE_ — they stay on the server and are
# proxied through /api/ai/complete so they are never exposed to the browser.

# OpenAI (gpt-5.4-pro, gpt-5.4-mini, gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic (claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5, claude-3.5-sonnet)
ANTHROPIC_API_KEY=

# Google (gemini-3.1-pro, gemini-3-flash, gemini-2.5-flash-lite)
GOOGLE_API_KEY=

# Groq/Llama (llama-4-maverick, llama-4-scout, llama-3.3-70b)
GROQ_API_KEY=

# MiniMax (minimax-m3, minimax-m2.7, minimax-m2.5)
MINIMAX_API_KEY=

# Moonshot/Kimi (kimi-latest, kimi-k2-thinking, kimi-k2-turbo-preview, kimi-k2.5-vision, moonshot-v1-128k)
MOONSHOT_API_KEY=

# Default AI model (auto-detects provider from model name)
AI_MODEL=gpt-4o

# --- Backend API ---
# Base URL for the PlayLens backend server
VITE_PLAYLENS_API_BASE=http://127.0.0.1:4174

# --- Storage ---
# How session data is stored: "app-data" (central) or "project-local" (per-project)
VITE_PLAYLENS_STORAGE_MODE=app-data

# --- AI Agent ---
# Default agent permission mode: "read-only", "ask-before-acting", "trusted-actions", "full-operator"
VITE_PLAYLENS_AGENT_MODE=ask-before-acting

# --- AI Feature Flag (frontend) ---
# Set to "true" to show AI features in the dashboard (keys stay server-side)
VITE_PLAYLENS_AI_ENABLED=true
