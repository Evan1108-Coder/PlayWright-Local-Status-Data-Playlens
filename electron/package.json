{
  "name": "playlens",
  "version": "1.0.0",
  "description": "PlayLens - Playwright Observability Dashboard",
  "main": "main.js",
  "author": "Evan Lu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prebuild": "node scripts/prepare-frontend.js",
    "build:mac": "npm run prebuild && electron-builder --mac",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:all": "npm run prebuild && electron-builder --mac --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.playlens.app",
    "productName": "PlayLens",
    "copyright": "Copyright (c) 2026 Evan Lu",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "extraResources": [],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "PlayLens",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlayLens"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": ["AppImage"],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  }
}
